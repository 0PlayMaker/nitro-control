    # ---- tray ----
    def _make_tray(self):
        self.tray = QSystemTrayIcon(make_icon(), self)
        self.tray.setToolTip("Nitro Control")
        m = QMenu()
        self.tray_limit = QAction("80 % battery limit", self, checkable=True)
        self.tray_limit.triggered.connect(self.set_battery)
        m.addAction(self.tray_limit)
        m.addSeparator()
        for label, key in [("Rainbow", "rainbow"), ("Aurora", "aurora"),
                           ("Ocean", "ocean"), ("Keyboard off", "off")]:
            a = QAction(label, self)
            a.triggered.connect(lambda _=False, k=key: self.apply(k))
            m.addAction(a)
        m.addSeparator()
        show = QAction("Open Nitro Control", self); show.triggered.connect(self.showNormal)
        m.addAction(show)
        quit_a = QAction("Quit", self); quit_a.triggered.connect(self.quit_app)
        m.addAction(quit_a)
        self.tray.setContextMenu(m)
        self.tray.activated.connect(
            lambda r: self.showNormal() if r == QSystemTrayIcon.Trigger else None)
        self.tray.show()

    # ---- RGB daemon + live state ----
    @staticmethod
    def _pid_is_daemon(pid):
        try:
            return "nitro-rgb-fx" in open(f"/proc/{pid}/cmdline").read()
        except Exception:
            return False

    def _ensure_daemon(self):
        # Reuse a running daemon (effects persist across GUI restarts/quit).
        try:
            pid = int(DAEMON_PID.read_text())
            if self._pid_is_daemon(pid):
                self.daemon_proc = None
                self.apply()
                return
        except Exception:
            pass
        # start_new_session=True so it survives the GUI process exiting.
        try:
            self.daemon_proc = subprocess.Popen([RGB, "daemon"], start_new_session=True)
            DAEMON_PID.parent.mkdir(parents=True, exist_ok=True)
            DAEMON_PID.write_text(str(self.daemon_proc.pid))
        except Exception:
            self.daemon_proc = None
        self.apply()

    def _load_state(self):
        """Restore the look you left. The live state wins; the Apply-saved
        default is the fallback for a first run or a wiped state file."""
        st = read_json(STATE_FILE) or read_json(DEFAULT_FILE)
        if st:
            self._apply_state(st)

    def _apply_state(self, st):
        """Push a saved state dict into every control. Signals are blocked
        throughout so this never triggers a premature apply()."""
        eff = st.get("effect")
        if eff:
            for i in range(self.eff_list.count()):
                if self.eff_list.item(i).data(Qt.UserRole) == eff:
                    self.eff_list.blockSignals(True)
                    self.eff_list.setCurrentRow(i)
                    self.eff_list.blockSignals(False)
                    break
            if eff != "off":
                self._last_effect = eff
            self._is_off = (eff == "off")
        for widget, key, mult in self._slider_map():
            val = st.get(key)
            if isinstance(val, (int, float)):
                widget.blockSignals(True)
                widget.setValue(int(round(val * mult)))
                widget.blockSignals(False)
        col = st.get("color")
        self.auto_color = not col
        if col:
            self.color = col
        self.auto_chk.blockSignals(True)
        self.auto_chk.setChecked(self.auto_color)
        self.auto_chk.blockSignals(False)
        self._paint_preview()
        io = st.get("idle_off")
        if io is not None:
            for i in range(self.autooff.count()):
                if int(self.autooff.itemData(i)) == int(io):
                    self.autooff.blockSignals(True)
                    self.autooff.setCurrentIndex(i)
                    self.autooff.blockSignals(False)
                    break
        self.wakepad.blockSignals(True)
        self.wakepad.setChecked(st.get("wake_source", "keyboard") == "any")
        self.wakepad.blockSignals(False)
        for combo, key, default in ((self.basszone, "bass_zone", 4),
                                    (self.vudir, "vu_reverse", False),
                                    (self.vusrc, "vu_source", "full"),
                                    (self.specdir, "spec_reverse", False)):
            val = st.get(key, default)
            for i in range(combo.count()):
                if combo.itemData(i) == val:
                    combo.blockSignals(True)
                    combo.setCurrentIndex(i)
                    combo.blockSignals(False)
                    break
        zc = st.get("zone_colors")
        parts = zc.split(",") if zc else []
        self.zone_colors = [(parts[i].strip() or None) if i < len(parts) else None
                            for i in range(4)]
        self._paint_zone_btns()
        self._paint_labels()
        self._update_off_btn()
        self._sync_effect_ui()
        self._sync_wake_hint()

    def _sync_wake_hint(self):
        """Keep the idle hint honest about what actually wakes the lights."""
        if self.wakepad.isChecked():
            self.autooff_hint.setText(
                "Counts from your last keypress or touchpad move, and fades\n"
                "back up the moment you touch either.")
        else:
            self.autooff_hint.setText(
                "Counts from your last keypress, and fades back up when you\n"
                "type. The touchpad won't wake it.")

    def _slider_map(self):
        """(widget, state key, units-per-slider-step) for every slider."""
        return ((self.bright, "brightness", 1),
                (self.speed, "speed", 10),
                (self.amp, "amplitude", 10),
                (self.bassg, "bass_gain", 10),
                (self.specg, "spec_gain", 10),
                (self.smooth, "snd_smooth", 100),
                (self.gate, "snd_gate", 100),
                (self.adapt, "snd_adapt", 100),
                (self.glow, "glow", 100))

    def current_key(self):
        it = self.eff_list.currentItem() if hasattr(self, "eff_list") else None
        return it.data(Qt.UserRole) if it else "gradient"

    def _paint_labels(self):
        self.bright_lbl.setText(f"{self.bright.value()}%")
        self.speed_lbl.setText(f"{self.speed.value() / 10:.1f}×")
        self.amp_lbl.setText(f"{self.amp.value() / 10:.1f}×")
        self.bassg_lbl.setText(f"{self.bassg.value() / 10:.1f}×")
        self.specg_lbl.setText(f"{self.specg.value() / 10:.1f}×")
        for key, widget in (("smooth", self.smooth), ("gate", self.gate),
                            ("adapt", self.adapt), ("glow", self.glow)):
            self._snd_rows[key][2].setText(f"{widget.value()}%")

    def schedule_apply(self):
        self._paint_labels()
        self._apply_timer.start(60)

    def _state_dict(self, effect=None):
        """The complete look — one definition shared by the live state, presets
        and the saved default, so nothing can be captured by one but not another."""
        st = {
            "effect": effect if effect is not None else self.current_key(),
            "color": (None if self.auto_color else self.color),
            "idle_off": int(self.autooff.currentData() or 0),
            "wake_source": "any" if self.wakepad.isChecked() else "keyboard",
            "zone_colors": (",".join(c or "" for c in self.zone_colors)
                            if any(self.zone_colors) else None),
            "bass_zone": int(self.basszone.currentData() or 4),
            "vu_reverse": bool(self.vudir.currentData()),
            "vu_source": self.vusrc.currentData() or "full",
            "spec_reverse": bool(self.specdir.currentData()),
        }
        for widget, key, mult in self._slider_map():
            st[key] = widget.value() if mult == 1 else round(widget.value() / mult, 3)
        return st

    def apply(self, effect=None):
        state = self._state_dict(effect)
        eff = state["effect"]
        try:
            write_json(STATE_FILE, state)
        except Exception:
            pass
        if eff != "off":
            self._last_effect = eff
        self._is_off = (eff == "off")
        self._update_off_btn()

    # ---- presets ----
    def _refresh_presets(self, select=None):
        try:
            names = sorted(f.stem for f in PRESET_DIR.glob("*.json"))
        except Exception:
            names = []
        self.preset_combo.blockSignals(True)
        self.preset_combo.clear()
        self.preset_combo.addItem("Presets…" if names else "No presets yet", None)
        for n in names:
            self.preset_combo.addItem(n, n)
        if select and select in names:
            self.preset_combo.setCurrentIndex(names.index(select) + 1)
        self.preset_combo.blockSignals(False)
        self.pdel.setEnabled(bool(self.preset_combo.currentData()))

    def on_preset_pick(self, *_):
        name = self.preset_combo.currentData()
        self.pdel.setEnabled(bool(name))
        if not name:
            return
        st = read_json(preset_file(name))
        if st is None:
            QMessageBox.warning(self, "Presets", f"Could not read preset '{name}'.")
            return
        self._apply_state(st)
        self.apply()

    def save_preset(self):
        cur = self.preset_combo.currentData() or ""
        name, ok = QInputDialog.getText(self, "Save preset", "Name this look:", text=cur)
        name = name.strip()
        if not ok or not name:
            return
        path = preset_file(name)
        if path.exists() and QMessageBox.question(
                self, "Save preset", f"'{name}' already exists. Replace it?") != QMessageBox.Yes:
            return
        try:
            write_json(path, self._state_dict())
        except Exception as e:
            QMessageBox.warning(self, "Presets", f"Could not save: {e}")
            return
        self._refresh_presets(select=path.stem)
        self.tray.showMessage("Nitro Control", f"Preset '{path.stem}' saved", make_icon(), 2500)

    def delete_preset(self):
        name = self.preset_combo.currentData()
        if not name:
            return
        if QMessageBox.question(self, "Delete preset",
                                f"Delete the preset '{name}'?") != QMessageBox.Yes:
            return
        try:
            preset_file(name).unlink(missing_ok=True)
        except Exception:
            pass
        self._refresh_presets()

    def toggle_off(self):
        if self._is_off:
            self.apply(self.current_key())   # turn back on with selected effect
        else:
            self.apply("off")

    def _update_off_btn(self):
        if hasattr(self, "offbtn"):
            self.offbtn.setText("Turn on" if self._is_off else "Turn off")

    # ---- colour ----
    def set_color(self, hexv):
        self.color = hexv
        self.auto_color = False
        self.auto_chk.blockSignals(True); self.auto_chk.setChecked(False); self.auto_chk.blockSignals(False)
        self._paint_preview()
        self.schedule_apply()

    def pick_color(self):
        c = QColorDialog.getColor(QColor(self.color), self, "Keyboard colour")
        if c.isValid():
            self.set_color(c.name())

    def pick_zone_color(self, idx):
        cur = self.zone_colors[idx] or self.color
        c = QColorDialog.getColor(QColor(cur), self, f"Zone {idx + 1} colour")
        if c.isValid():
            self.zone_colors[idx] = c.name()
            self._paint_zone_btns()
            self.schedule_apply()

    def clear_zone_colors(self):
        self.zone_colors = [None] * 4
        self._paint_zone_btns()
        self.schedule_apply()

    def _paint_zone_btns(self):
        for i, b in enumerate(self.zone_btns):
            c = self.zone_colors[i]
            if c:
                b.setStyleSheet(f"background:{c}; color:#000; font-weight:700;"
                                "border:1px solid #333846; border-radius:6px;")
            else:
                b.setStyleSheet("")

    # Which sound controls each preset actually listens to. Rows that would do
    # nothing are hidden rather than greyed, so the panel only ever shows knobs
    # that will change what you see.
    SOUND_ROWS = {
        "sound": ("bass", "spec", "smooth", "gate", "adapt", "glow", "specdir"),
        "soundbass": ("bass", "spec", "smooth", "gate", "adapt", "glow",
                      "basszone", "vudir", "vusrc"),
        "soundwave": ("bass", "spec", "smooth", "gate", "adapt", "glow"),
    }

    def _sync_effect_ui(self):
        """Only offer the controls the selected effect actually listens to."""
        eff = self.current_key()
        is_sound = eff in self.SOUND_ROWS
        self.sndbox.setEnabled(is_sound)
        self.sndbox.setTitle("Sound reactive" if is_sound
                             else "Sound reactive  ·  pick a 🔊 effect")
        shown = self.SOUND_ROWS.get(eff, self.SOUND_ROWS["soundwave"])
        for key, widgets in self._snd_rows.items():
            for wdg in widgets:
                wdg.setVisible(key in shown)
        per_zone = eff in ("sound", "soundbass", "zones")
        for b in self.zone_btns:
            b.setEnabled(per_zone)

    def on_auto_toggle(self, v):
        self.auto_color = v
        self._paint_preview()
        self.schedule_apply()

    def _paint_preview(self):
        if self.auto_color:
            self.color_preview.setStyleSheet(
                "border-radius:7px; border:1px solid #333846; background: qlineargradient("
                "x1:0 y1:0 x2:1 y2:0, stop:0 #ff2d2d, stop:0.5 #00e05a, stop:1 #2b6bff);")
        else:
            self.color_preview.setStyleSheet(
                f"border-radius:7px; border:1px solid #333846; background:{self.color};")

    def save_default(self):
        """Apply: commit the current look everywhere it needs to live to survive
        a reboot — the live state the daemon renders, the user-level default the
        GUI falls back to, and the system config the boot service applies before
        the desktop is even up."""
        self.apply()
        st = self._state_dict()
        try:
            write_json(DEFAULT_FILE, st)
        except Exception:
            pass
        args = ["kb", "set-default", st["effect"] if st["effect"] != "off" else self._last_effect,
                "--brightness", str(st["brightness"]), "--speed", str(st["speed"])]
        if st.get("color"):
            args += ["--color", st["color"]]
        nitroctl(*args)
        self.applybtn.setText("✓  Saved")
        QTimer.singleShot(1600, lambda: self.applybtn.setText("Apply"))
        self.tray.showMessage("Nitro Control", "Saved — this look comes back after a reboot",
                              make_icon(), 3000)

    # ---- battery ----
    def set_battery(self, on):
        _, _, err = nitroctl("battery", "on" if on else "off")
        if err:
            QMessageBox.warning(self, "Battery", err + "\n\nIf you just installed, log out and "
                                "back in so your user joins the 'nitro' group.")
        self.refresh_once()

    def copy_diag(self):
        _, out, err = nitroctl("diag")
        QApplication.clipboard().setText((out + "\n" + err).strip())
        self.tray.showMessage("Nitro Control", "Diagnostic bundle copied to clipboard", make_icon(), 3000)

    def refresh_once(self):
        _, out, _ = nitroctl("status", "--json")
        try:
            self.on_status(json.loads(out))
        except Exception:
            pass

    def on_status(self, s):
        if not s:
            return
        b = s.get("battery", {}); cpu = s.get("cpu", {}); gpu = s.get("gpu", {})
        self._last_batt = b
        ct = cpu.get("temp_c")
        self.s_cpu.set(f"{ct} °C" if ct is not None else "n/a", temp_color(ct))
        nv = gpu.get("nvidia")
        if nv:
            self.s_gpu.set(f"{nv['temp_c']} °C · {nv['power_w']} W", temp_color(nv["temp_c"]))
        else:
            self.s_gpu.set("n/a")
        it = gpu.get("amd_temp_c")
        self.s_igpu.set(f"{it} °C" if it is not None else "n/a", temp_color(it))
        cap = b.get("capacity")
        self.s_batt.set(f"{cap}%" if cap is not None else "n/a")
        self.s_batt.set_bar(cap)
        self.s_ac.set("Plugged" if b.get("ac_online") else "On battery")
        hm = b.get("health_mode")
        self.s_limit.set("ON" if hm else "OFF" if hm is not None else "n/a",
                         GREEN if hm else None)
        if hasattr(self, "batt_switch"):
            self.batt_switch.blockSignals(True); self.batt_switch.setChecked(bool(hm)); self.batt_switch.blockSignals(False)
            self.tray_limit.blockSignals(True); self.tray_limit.setChecked(bool(hm)); self.tray_limit.blockSignals(False)
            self.batt_status_lbl.setText("ON" if hm else "OFF")
            self.batt_status_lbl.setStyleSheet(f"font-weight:700; color:{GREEN if hm else '#8b91a0'};")
            self.batt_state.setText(
                f"Charge {b.get('capacity')} %  ·  {b.get('status')}  ·  "
                f"{'plugged in' if b.get('ac_online') else 'on battery'}")
            wear = b.get("wear_pct")
            self.batt_wear.setText(
                f"Wear: {wear} %   (full charge holds {b.get('energy_full', 0) // 1000} of "
                f"{b.get('energy_full_design', 0) // 1000} mWh original design)"
                if wear is not None else "Wear: n/a")
            self._sync_calibration(b)

    # ---- lifecycle ----
    def hideEvent(self, e):
        if hasattr(self, "poller"):
            self.poller.pause(True)
        super().hideEvent(e)

    def showEvent(self, e):
        if hasattr(self, "poller"):
            self.poller.pause(False)
        super().showEvent(e)

    def closeEvent(self, e):
        if self.tray.isVisible():
            self.hide(); e.ignore()
        else:
            self.quit_app()

    def quit_app(self):
        # Leave the RGB daemon running so effects persist after the GUI exits.
        self.poller.stop(); self.poller.wait(1500)
        self.tray.hide()
        self.app.quit()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Nitro Control")
    app.setQuitOnLastWindowClosed(False)
    try:
        app.setStyle("Fusion")
    except Exception:
        pass
    app.setStyleSheet(QSS)
    win = MainWindow(app)
    if "--minimized" not in sys.argv:
        win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
