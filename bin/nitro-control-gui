        self.basszone.setCurrentIndex(3)                 # zone 4 = far right
        self.basszone.currentIndexChanged.connect(lambda *_: self.schedule_apply())
        self._snd_row(g, 7, "basszone", "Bass zone", self.basszone, None,
                      "Which zone is the dedicated bass meter")

        self.vudir = QComboBox()
        self.vudir.addItem("From zone 1 outwards", False)
        self.vudir.addItem("From the far end back", True)
        self.vudir.currentIndexChanged.connect(lambda *_: self.schedule_apply())
        self._snd_row(g, 8, "vudir", "Meter fills", self.vudir, None,
                      "Direction the volume meter climbs as it gets louder")

        self.vusrc = QComboBox()
        self.vusrc.addItem("Whole mix", "full")
        self.vusrc.addItem("Mids + treble only", "nobass")
        self.vusrc.addItem("Bass only", "bass")
        self.vusrc.currentIndexChanged.connect(lambda *_: self.schedule_apply())
        self._snd_row(g, 9, "vusrc", "Meter reads", self.vusrc, None,
                      "What the volume meter listens to. 'Mids + treble' keeps it "
                      "independent of the dedicated bass zone")
        return self.sndbox

