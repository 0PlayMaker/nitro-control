def write_json(path, data):
    """Atomic write — the RGB daemon polls these files and must never read a
    half-written one."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, path)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except Exception:
        return None


def preset_file(name):
    safe = "".join(c for c in str(name) if c.isalnum() or c in " _-").strip()
    return PRESET_DIR / f"{safe or 'preset'}.json"


def nitroctl(*args, timeout=8):
    try:
        p = subprocess.run([NITROCTL, *args], capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except Exception as e:
        return 1, "", str(e)


def caps():
    _, out, _ = nitroctl("caps", "--json")
    try:
        return json.loads(out)
    except Exception:
        return {}


def temp_color(c):
    if c is None:
        return None
    if c >= 85:
        return RED
    if c >= 72:
        return AMBER
    return GREEN


def make_icon():
    pm = QPixmap(64, 64)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    g = QLinearGradient(0, 0, 64, 64)
    g.setColorAt(0, QColor(ACCENT))
    g.setColorAt(1, QColor(ACCENT2))
    p.setBrush(QBrush(g))
    p.setPen(Qt.NoPen)
    p.drawRoundedRect(6, 6, 52, 52, 15, 15)
    p.setPen(QColor("white"))
    f = p.font(); f.setBold(True); f.setPointSize(30); p.setFont(f)
    p.drawText(pm.rect(), Qt.AlignCenter, "N")
    p.end()
    return QIcon(pm)


class ToggleSwitch(QCheckBox):
    """A clear sliding on/off switch (green = on, grey = off)."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setCursor(Qt.PointingHandCursor)
        self.setFixedSize(56, 30)

    def sizeHint(self):
        return QSize(56, 30)

    def hitButton(self, pos):
        return self.contentsRect().contains(pos)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        on = self.isChecked()
        p.setBrush(QColor(GREEN if on else "#3a3f4c"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(0, 3, 56, 24, 12, 12)
        p.setBrush(QColor("white"))
        p.drawEllipse(31 if on else 3, 5, 20, 20)
        p.end()


class StatCard(QFrame):
    def __init__(self, icon, title, bar=False):
        super().__init__()
        self.setObjectName("card")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(16, 14, 16, 14)
        lay.setSpacing(6)
        top = QHBoxLayout()
        ic = QLabel(icon); ic.setStyleSheet("font-size: 15px;")
        tt = QLabel(title); tt.setObjectName("stattitle")
        top.addWidget(ic); top.addSpacing(4); top.addWidget(tt); top.addStretch()
        lay.addLayout(top)
        self.v = QLabel("—")
        self.v.setStyleSheet("font-size: 21px; font-weight: 700;")
        lay.addWidget(self.v)
        self.bar = None
        if bar:
            self.bar = QProgressBar()
            self.bar.setTextVisible(False)
            self.bar.setRange(0, 100)
            self.bar.setFixedHeight(6)
            lay.addWidget(self.bar)

    def set(self, val, color=None):
        self.v.setText(str(val))
        self.v.setStyleSheet(
            f"font-size: 21px; font-weight: 700; color: {color};" if color
            else "font-size: 21px; font-weight: 700;")

    def set_bar(self, pct):
        if self.bar is not None and pct is not None:
            self.bar.setValue(int(pct))


class Poller(QThread):
    updated = Signal(dict)

    def __init__(self):
        super().__init__()
        self._run = True
        self._paused = False

    def run(self):
        while self._run:
            if not self._paused:
                _, out, _ = nitroctl("status", "--json")
                try:
                    self.updated.emit(json.loads(out))
                except Exception:
                    self.updated.emit({})
            for _ in range(20):
                if not self._run:
                    return
                self.msleep(100)

    def pause(self, v):
        self._paused = v

    def stop(self):
        self._run = False


class MainWindow(QMainWindow):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.caps = caps()
        self.color = "#9628ff"
        self.auto_color = True
        self.zone_colors = [None] * 4      # per-zone overrides, left -> right
        self._last_effect = "gradient"
        self._is_off = False
        self.daemon_proc = None
        # Last battery poll, so the calibration button can check AC and session
        # state without shelling out again on every click.
        self._last_batt = {}
        self._calib_was_running = False

        self.setWindowTitle("Nitro Control")
        self.setWindowIcon(make_icon())
        self.resize(980, 820)

        self._apply_timer = QTimer(self); self._apply_timer.setSingleShot(True)
        self._apply_timer.timeout.connect(self.apply)

        central = QWidget(); outer = QVBoxLayout(central)
        outer.setContentsMargins(0, 0, 0, 0); outer.setSpacing(0)
        outer.addWidget(self._header())
        tabs = QTabWidget()
        tabs.addTab(self._dashboard_tab(), "  Dashboard  ")
        if self.caps.get("battery"):
            tabs.addTab(self._battery_tab(), "  Battery  ")
        if self.caps.get("keyboard"):
            tabs.addTab(self._keyboard_tab(), "  Keyboard  ")
        tabs.addTab(self._fans_tab(), "  Fans  ")
        tabs.addTab(self._about_tab(), "  About  ")
        outer.addWidget(tabs)
        self.setCentralWidget(central)

        if self.caps.get("keyboard"):
            self._load_state()   # reflect the saved look instead of clobbering it
        self._make_tray()
        self._ensure_daemon()
        self.poller = Poller()
        self.poller.updated.connect(self.on_status)
        self.poller.start()

