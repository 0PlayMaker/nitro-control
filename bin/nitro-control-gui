    def _calibration_box(self):
        """Gauge calibration. Deliberately understated and hard to start by
        accident: it takes hours, needs mains power, and turns the charge limit
        off while it runs."""
        box = QGroupBox("Gauge calibration")
        cl = QVBoxLayout(box)
        blurb = QLabel(
            "Wear is estimated by the battery's own fuel gauge, and that estimate "
            "drifts. A calibration cycle runs the pack down to empty and back to "
            "full so the gauge can re-learn the real capacity — worth doing when "
            "the reported charge starts jumping or wear looks off.")
        blurb.setWordWrap(True); blurb.setObjectName("muted")
        cl.addWidget(blurb)
        self.calib_state = QLabel("—")
        self.calib_state.setWordWrap(True)
        self.calib_state.setStyleSheet("font-weight: 700;")
        cl.addWidget(self.calib_state)
        row = QHBoxLayout()
        self.calib_btn = QPushButton("Start calibration…")
        self.calib_btn.clicked.connect(self.on_calibrate)
        row.addWidget(self.calib_btn); row.addStretch()
        cl.addLayout(row)
        return box

    def on_calibrate(self):
        """Start or stop a cycle, with a confirmation that spells out the cost."""
        running = bool(self._last_batt.get("calibration_active"))
        if running:
            ok = QMessageBox.question(
                self, "Finish calibration?",
                "Stop the calibration cycle and put the charge limit back?\n\n"
                "Only do this once the battery has charged back to full — "
                "stopping early leaves the gauge no better than before.",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
            if ok != QMessageBox.Yes:
                return
            rc, out, err = nitroctl("battery", "calibrate", "stop")
        else:
            b = self._last_batt
            if not b.get("ac_online"):
                QMessageBox.warning(
                    self, "Plug in first",
                    "Calibration needs to charge the pack to full, so the AC "
                    "adapter has to be connected before it can start.")
                return
            ok = QMessageBox.question(
                self, "Start battery calibration?",
                "This runs the battery down to empty and back to full so the "
                "gauge can re-learn its capacity.\n\n"
                "  • it takes several hours\n"
                "  • leave the AC adapter plugged in the whole time\n"
                "  • the 80 % charge limit is turned off until it finishes, "
                "then restored\n"
                "  • the laptop stays usable throughout\n\n"
                "Start now?",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
            if ok != QMessageBox.Yes:
                return
            rc, out, err = nitroctl("battery", "calibrate", "start")
        self.refresh_once()
        if rc != 0:
            QMessageBox.warning(self, "Calibration",
                                err or out or "nitroctl reported an error.")
            return
        first = (out or "").splitlines()[0] if out else (
            "Calibration stopped" if running else "Calibration started")
        self.tray.showMessage("Nitro Control", first, make_icon(), 4000)

    def _sync_calibration(self, b):
        """Reflect the battery poll into the calibration box."""
        supported = bool(b.get("calibration_supported"))
        running = supported and bool(b.get("calibration_active"))
        # The timer can finish a cycle while nobody is looking, so say so.
        if self._calib_was_running and not running and supported:
            self.tray.showMessage(
                "Nitro Control",
                "Battery calibration finished — the charge limit is back on.",
                make_icon(), 6000)
        self._calib_was_running = running
        # Turning the charge limit back on mid-cycle would stop the pack ever
        # reaching full and quietly stall the calibration, so take it out of
        # reach for the duration rather than letting it be undone by accident.
        # Done before any early return, so the lock can never be left stuck on
        # if the driver disappears while a cycle is recorded.
        for wdg in (getattr(self, "batt_switch", None), getattr(self, "tray_limit", None)):
            if wdg is not None:
                wdg.setEnabled(not running)
        if hasattr(self, "batt_switch"):
            self.batt_switch.setToolTip(
                "Paused while the battery is calibrating — it needs to charge "
                "to full." if running else "")
        self.calib_btn.setEnabled(supported)
        if not supported:
            self.calib_state.setText("Not supported by this firmware")
            self.calib_btn.setText("Start calibration…")
            return
        if running:
            self.calib_state.setText(
                f"Running — charge {b.get('capacity', '?')} %, "
                f"{'plugged in' if b.get('ac_online') else 'ON BATTERY — plug it back in'}. "
                "Let it discharge fully and recharge, then finish.")
            self.calib_btn.setText("Finish calibration…")
        else:
            self.calib_state.setText("Not running")
            self.calib_btn.setText("Start calibration…")

    # ---- Keyboard ----
    def _keyboard_tab(self):
        w = QWidget(); root = QHBoxLayout(w); root.setContentsMargins(18, 18, 18, 18); root.setSpacing(16)

        self.eff_list = QListWidget()
        for label, key in EFFECTS:
            it = QListWidgetItem(label); it.setData(Qt.UserRole, key)
            self.eff_list.addItem(it)
        self.eff_list.setCurrentRow(2)  # plasma
        self.eff_list.setMaximumWidth(285)
        self.eff_list.currentItemChanged.connect(
            lambda *_: (self._sync_effect_ui(), self.schedule_apply()))
        root.addWidget(self.eff_list, 0)

        panel = QVBoxLayout(); panel.setSpacing(12)
        panel.addWidget(self._preset_box())

        cbox = QGroupBox("Colour theme")
        cl = QVBoxLayout(cbox)
        sw = QGridLayout(); sw.setSpacing(6)
        for i, (name, hexv) in enumerate(PRESETS):
            b = QPushButton(); b.setFixedSize(30, 30); b.setToolTip(name)
            b.setStyleSheet(f"background:{hexv}; border:1px solid #333846; border-radius:6px;")
            b.clicked.connect(lambda _=False, h=hexv: self.set_color(h))
            sw.addWidget(b, i // 5, i % 5)
        cl.addLayout(sw)
        row = QHBoxLayout()
        custom = QPushButton("Custom…"); custom.clicked.connect(self.pick_color)
        self.auto_chk = QCheckBox("Natural (per-effect)")
        self.auto_chk.setChecked(True); self.auto_chk.toggled.connect(self.on_auto_toggle)
        self.color_preview = QLabel(); self.color_preview.setFixedSize(26, 26)
        row.addWidget(custom); row.addWidget(self.auto_chk); row.addStretch()
        row.addWidget(QLabel("Now:")); row.addWidget(self.color_preview)
        cl.addLayout(row)

        zrow = QHBoxLayout()
        zl = QLabel("Per-zone"); zl.setObjectName("muted")
        zrow.addWidget(zl); zrow.addSpacing(6)
        self.zone_btns = []
        for z in range(4):
            b = QPushButton(str(z + 1)); b.setFixedSize(32, 27)
            b.setToolTip(f"Zone {z + 1} colour  (zone 1 = far left, 4 = far right)")
            b.clicked.connect(lambda _=False, i=z: self.pick_zone_color(i))
            self.zone_btns.append(b); zrow.addWidget(b)
        zreset = QPushButton("Reset"); zreset.setToolTip("Back to the effect's own colours")
        zreset.clicked.connect(self.clear_zone_colors)
        zrow.addSpacing(6); zrow.addWidget(zreset); zrow.addStretch()
        cl.addLayout(zrow)
        panel.addWidget(cbox)
        self._paint_preview()
        self._paint_zone_btns()

        sbox = QGroupBox("Adjust"); sg = QGridLayout(sbox); sg.setVerticalSpacing(14)
        sg.addWidget(QLabel("Brightness"), 0, 0)
        self.bright = QSlider(Qt.Horizontal); self.bright.setRange(1, 100); self.bright.setValue(100)
        self.bright.valueChanged.connect(lambda *_: self.schedule_apply())
        self.bright_lbl = QLabel("100%"); self.bright_lbl.setObjectName("muted"); self.bright_lbl.setFixedWidth(48)
        sg.addWidget(self.bright, 0, 1); sg.addWidget(self.bright_lbl, 0, 2)
        sg.addWidget(QLabel("Speed"), 1, 0)
        self.speed = QSlider(Qt.Horizontal); self.speed.setRange(1, 30); self.speed.setValue(10)
        self.speed.valueChanged.connect(lambda *_: self.schedule_apply())
        self.speed_lbl = QLabel("1.0×"); self.speed_lbl.setObjectName("muted"); self.speed_lbl.setFixedWidth(48)
        sg.addWidget(self.speed, 1, 1); sg.addWidget(self.speed_lbl, 1, 2)
        sg.addWidget(QLabel("Intensity"), 2, 0)
        self.amp = QSlider(Qt.Horizontal); self.amp.setRange(2, 30); self.amp.setValue(10)
        self.amp.valueChanged.connect(lambda *_: self.schedule_apply())
        self.amp_lbl = QLabel("1.0×"); self.amp_lbl.setObjectName("muted"); self.amp_lbl.setFixedWidth(48)
        sg.addWidget(self.amp, 2, 1); sg.addWidget(self.amp_lbl, 2, 2)
        sg.addWidget(QLabel("Turn off when idle"), 3, 0)
        self.autooff = QComboBox()
        for label, secs in AUTO_OFF:
            self.autooff.addItem(label, secs)
        self.autooff.setCurrentIndex(self.autooff.count() - 1)  # default: Never
        self.autooff.currentIndexChanged.connect(lambda *_: self.schedule_apply())
        sg.addWidget(self.autooff, 3, 1)
        sg.addWidget(QLabel("Touchpad wakes lights"), 4, 0)
        self.wakepad = ToggleSwitch()
        self.wakepad.toggled.connect(lambda *_: self._sync_wake_hint())
        self.wakepad.toggled.connect(lambda *_: self.schedule_apply())
        sg.addWidget(self.wakepad, 4, 1)
        self.autooff_hint = QLabel()
        self.autooff_hint.setObjectName("muted")
        sg.addWidget(self.autooff_hint, 5, 1, 1, 2)
        self._sync_wake_hint()
        panel.addWidget(sbox)
        panel.addWidget(self._sound_box())

        brow = QHBoxLayout()
        self.offbtn = QPushButton("Turn off"); self.offbtn.clicked.connect(self.toggle_off)
        self.applybtn = QPushButton("Apply"); self.applybtn.setObjectName("accent")
        self.applybtn.setMinimumWidth(120)
        self.applybtn.setToolTip("Save everything on this tab as your default — "
                                 "it comes back after a reboot or re-login")
        self.applybtn.clicked.connect(self.save_default)
        brow.addWidget(self.offbtn); brow.addStretch(); brow.addWidget(self.applybtn)
        panel.addLayout(brow); panel.addStretch()

        # The panel is taller than most windows, so let it scroll rather than
        # clip the buttons off the bottom.
        holder = QWidget(); holder.setLayout(panel)
        scroll = QScrollArea(); scroll.setWidget(holder)
        scroll.setWidgetResizable(True); scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        root.addWidget(scroll, 1)
        self._refresh_presets()
        self._sync_effect_ui()
        return w

    def _preset_box(self):
        box = QGroupBox("My presets")
        lay = QVBoxLayout(box)
        row = QHBoxLayout()
        self.preset_combo = QComboBox()
        self.preset_combo.setToolTip("A preset stores this whole tab: effect, colours, "
                                     "brightness, idle timer and every sound setting")
        self.preset_combo.currentIndexChanged.connect(self.on_preset_pick)
        psave = QPushButton("Save…"); psave.setToolTip("Save the current look as a preset")
        psave.clicked.connect(self.save_preset)
        self.pdel = QPushButton("Delete"); self.pdel.setEnabled(False)
        self.pdel.clicked.connect(self.delete_preset)
        row.addWidget(self.preset_combo, 1); row.addWidget(psave); row.addWidget(self.pdel)
        lay.addLayout(row)
        return box

    def _snd_row(self, grid, r, key, text, widget, tail=None, tip=None):
        lab = QLabel(text)
        if tip:
            lab.setToolTip(tip); widget.setToolTip(tip)
        grid.addWidget(lab, r, 0); grid.addWidget(widget, r, 1)
        row = [lab, widget]
        if tail is not None:
            grid.addWidget(tail, r, 2); row.append(tail)
        self._snd_rows[key] = row
        return widget

    def _snd_slider(self, lo, hi, val):
        s = QSlider(Qt.Horizontal); s.setRange(lo, hi); s.setValue(val)
        s.valueChanged.connect(lambda *_: self.schedule_apply())
        return s

    @staticmethod
    def _tail():
        l = QLabel(""); l.setObjectName("muted"); l.setFixedWidth(58)
        return l

    def _sound_box(self):
        self.sndbox = QGroupBox("Sound reactive")
        self._snd_rows = {}
        g = QGridLayout(self.sndbox); g.setVerticalSpacing(12)

        self.bassg = self._snd_row(g, 0, "bass", "Bass", self._snd_slider(1, 40, 10),
                                   self._tail(), "How hard the bass drives the lights")
        self.bassg_lbl = self._snd_rows["bass"][2]
        self.specg = self._snd_row(g, 1, "spec", "Spectrum", self._snd_slider(1, 40, 10),
                                   self._tail(),
                                   "How hard the mids, treble and overall volume drive them")
        self.specg_lbl = self._snd_rows["spec"][2]
        self.smooth = self._snd_row(g, 2, "smooth", "Smoothing", self._snd_slider(0, 100, 57),
                                    self._tail(),
                                    "Low = snappy and twitchy, high = flows with the music")
        self.gate = self._snd_row(g, 3, "gate", "Noise gate", self._snd_slider(0, 100, 13),
                                  self._tail(),
                                  "Ignore quiet room noise so the zones rest properly in silence")
        self.adapt = self._snd_row(g, 4, "adapt", "Auto-level", self._snd_slider(0, 100, 50),
                                   self._tail(),
                                   "Low = re-levels fast so quiet tracks still fill the zones, "
                                   "high = holds a steady reference so loud and quiet look different")
        self.glow = self._snd_row(g, 5, "glow", "Resting glow", self._snd_slider(0, 50, 8),
                                  self._tail(),
                                  "What the keyboard sits at when nothing is playing — "
                                  "0 % looks exactly like the lights being off")

        self.specdir = QComboBox()
        self.specdir.addItem("Bass on the left", False)
        self.specdir.addItem("Bass on the right", True)
        self.specdir.currentIndexChanged.connect(lambda *_: self.schedule_apply())
        self._snd_row(g, 6, "specdir", "Bar direction", self.specdir, None,
                      "Which end of the keyboard the low frequencies sit on")

        self.basszone = QComboBox()
        for z in range(1, 5):
