}

STATIC_EFFECTS = {"solid", "gradient", "gradient2", "zones", "off"}
SOUND_EFFECTS = {"sound", "soundbass", "soundwave"}
PROFILE_KEYS = ("effect", "seconds", "brightness", "speed", "amplitude", "fps",
                "color", "color2", "reverse", "gamma", "zone_colors",
                "bass_gain", "spec_gain", "bass_zone", "vu_reverse",
                "vu_source", "spec_reverse", "glow", "snd_smooth",
                "snd_gate", "snd_adapt")
# Everything a saved look is made of — used for presets and the boot default.
STATE_KEYS = ("effect", "brightness", "speed", "amplitude", "color", "color2",
              "idle_off", "zone_colors", "bass_gain", "spec_gain", "bass_zone",
              "vu_reverse", "vu_source", "spec_reverse", "glow", "snd_smooth",
              "snd_gate", "snd_adapt", "fps", "gamma", "reverse")


def run_effect(name, a, seconds, fps=None):
    fn = EFFECTS[name][0]
    if name in STATIC_EFFECTS:
        show(fn(0, a), a.brightness)
        return
    dt = 1.0 / (fps or a.fps)
    t0 = time.monotonic()
    deadline = t0 + seconds if seconds else None
    while True:
        show(fn(time.monotonic() - t0, a), a.brightness)
        if deadline and time.monotonic() >= deadline:
            return
        time.sleep(dt)


# ---- idle input monitor (for daemon idle-off / wake-on-keypress) -------------
class IdleMonitor:
    """Time since the last real user input, read straight from evdev.

    Two things make the naive "glob /dev/input/event* once at startup" approach
    unreliable, and both are handled here:

      * Key remappers (input-remapper, keyd, kmonad...) EVIOCGRAB the physical
        keyboard and re-emit keystrokes on a *virtual* node created later. Hold
        only the original and typing looks like idleness, so the lights drop
        while you are mid-sentence.
      * Devices come and go — remapper reloads, USB/Bluetooth keyboards, resume.

    So the device set is refreshed whenever /dev/input changes (one cheap stat,
    not a re-glob), and only nodes that actually report keys/motion are opened.
    """
    EV_KEY, EV_REL, EV_ABS = 0x2, 0x4, 0x8   # bit N of the EV mask = event type N
    SCAN_THROTTLE = 1.0

    def __init__(self):
        self.fds = {}                 # path -> fd
        self.ok = False
        self.last = time.monotonic()
        self._dir_mtime = None
        self._next_scan = 0.0
        self._scan(force=True)

    @classmethod
    def _wanted(cls):
        """Event nodes that report keys, pointer motion or touch — skipping
        jack-sense, lid and PC-speaker nodes that never signal user presence."""
        try:
            text = open("/proc/bus/input/devices").read()
        except Exception:
            return set(glob.glob("/dev/input/event*"))
        want, care = set(), cls.EV_KEY | cls.EV_REL | cls.EV_ABS
        for block in text.split("\n\n"):
            node, ev = None, 0
            for line in block.splitlines():
                if line.startswith("H: Handlers"):
                    for tok in line.split("=", 1)[-1].split():
                        if tok.startswith("event"):
                            node = "/dev/input/" + tok
                elif line.startswith("B: EV="):
                    try:
                        ev = int(line.split("=", 1)[-1], 16)
                    except ValueError:
                        ev = 0
            if node and ev & care:
                want.add(node)
        return want or set(glob.glob("/dev/input/event*"))

    def _scan(self, force=False):
        now = time.monotonic()
        if not force and now < self._next_scan:
            return
        self._next_scan = now + self.SCAN_THROTTLE
        try:
            mtime = os.stat("/dev/input").st_mtime_ns
        except Exception:
            mtime = None
        if not force and mtime == self._dir_mtime:
            return                     # nothing added or removed since last look
        self._dir_mtime = mtime
        want = self._wanted()
        for path in [p for p in self.fds if p not in want]:
            try:
                os.close(self.fds.pop(path))
            except Exception:
                self.fds.pop(path, None)
        for path in want:
            if path not in self.fds:
                try:
                    self.fds[path] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                except Exception:
                    pass
        self.ok = bool(self.fds)

    def _drain(self, fds):
        for fd in fds:
            try:
                while os.read(fd, 4096):
                    pass
            except BlockingIOError:
                pass
            except OSError:
                self._dir_mtime = None      # device vanished — rescan next tick
                self._next_scan = 0.0
        self.last = time.monotonic()

    def wait(self, timeout):
        """Sleep up to `timeout`, returning the moment any input arrives. Used
        instead of time.sleep() while the lights are idle-off, so waking is
        instant and the daemon isn't spinning at 10 Hz doing nothing."""
        self._scan()
        if not self.fds:
            time.sleep(timeout)
            return False
        try:
            r, _, _ = select.select(list(self.fds.values()), [], [], timeout)
        except Exception:
            self._scan(force=True)
            return False
        if r:
            self._drain(r)
            return True
        return False

    def poll(self):
        self.wait(0)

    def idle_for(self):
        return time.monotonic() - self.last


# ---- state + daemon ----------------------------------------------------------
FALLBACK_STATE = {"effect": "gradient", "brightness": 100, "speed": 1.0, "color": None}
_state_cache = {"sig": None, "data": None}


def write_json(path, data):
    """Write atomically: the daemon polls these files constantly and must never
    catch a half-written one."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, path)


def read_state():
    """Cached on (mtime, size), so a busy render loop costs one stat() per frame
    instead of a full re-read and JSON parse. A torn or unreadable file keeps
    the last good state rather than snapping back to hardcoded defaults."""
    try:
        s = STATE_FILE.stat()
        sig = (s.st_mtime_ns, s.st_size)
    except Exception:
        return _state_cache["data"] or dict(FALLBACK_STATE)
    if sig == _state_cache["sig"] and _state_cache["data"] is not None:
        return _state_cache["data"]
    try:
        data = json.loads(STATE_FILE.read_text())
    except Exception:
        return _state_cache["data"] or dict(FALLBACK_STATE)
    _state_cache["sig"], _state_cache["data"] = sig, data
    return data


def write_state(**kw):
    st = dict(read_state())
    st.update(kw)
    write_json(STATE_FILE, st)
    _state_cache["sig"] = None
    return st


# ---- presets (named looks the GUI saves and restores) ------------------------
def preset_path(name):
    safe = "".join(c for c in str(name) if c.isalnum() or c in " _-").strip()
    return PRESET_DIR / f"{safe or 'preset'}.json"


def list_presets():
    try:
        return sorted(f.stem for f in PRESET_DIR.glob("*.json"))
    except Exception:
        return []


def save_preset(name, state=None):
    st = state if state is not None else read_state()
    write_json(preset_path(name), {k: st[k] for k in STATE_KEYS if k in st})


def load_preset(name):
    f = preset_path(name)
    if not f.exists():
        return None
    try:
        return json.loads(f.read_text())
    except Exception:
        return None


def _state_to_args(st):
    a = argparse.Namespace()
    a.speed = float(st.get("speed", 1.0))
    a.amp = float(st.get("amplitude", 1.0))
    a.fps = float(st.get("fps", 18))
    a.brightness = int(st.get("brightness", 100))
    a.reverse = bool(st.get("reverse", False))
    a.gamma = float(st.get("gamma", 1.0))
    col = st.get("color")
    a.color_set = bool(col)
    a.rgb = parse_color(col) if a.color_set else parse_color("purple")
    c2 = st.get("color2")
    a.rgb2 = parse_color(c2) if c2 else parse_color("cyan")
    a.zone_rgb = parse_zones(st.get("zone_colors"))
    a.bass_gain = float(st.get("bass_gain", 1.0))
    a.spec_gain = float(st.get("spec_gain", 1.0))
    a.bass_zone = int(st.get("bass_zone", ZONES) or ZONES)
    a.vu_reverse = bool(st.get("vu_reverse", False))
    a.vu_source = st.get("vu_source", "full") or "full"
    a.spec_reverse = bool(st.get("spec_reverse", False))
    a.glow = float(st.get("glow", 0.08))
    a.snd_smooth = float(st.get("snd_smooth", 0.57))
    a.snd_gate = float(st.get("snd_gate", 0.13))
    a.snd_adapt = float(st.get("snd_adapt", 0.5))
    return a


FADE_OUT = 0.6          # seconds: dip to black when the idle timer fires
FADE_IN = 0.35          # seconds: swell back up on the first keypress


def daemon():
    idle = IdleMonitor()
    t0 = time.monotonic()
    last_static = None
    last_frame = [(0, 0, 0)] * ZONES
    off_frame = [(0, 0, 0)] * ZONES
    wake_until = 0.0
    while True:
        st = read_state()
        a = _state_to_args(st)
        GAMMA[0] = a.gamma
        eff = st.get("effect", "gradient")
        idle_off = float(st.get("idle_off", 0) or 0)

        idle.poll()
        # Idle-off only when we can actually detect input; otherwise stay on.
        idled = idle.ok and idle_off > 0 and idle.idle_for() > idle_off and eff != "off"

        fn = EFFECTS.get(eff, EFFECTS["gradient"])[0]
        t = time.monotonic() - t0
        if idled:
            if last_static != "idled":
                # Ease down rather than cutting, so the idle timer is obviously
                # the idle timer and not the effect having gone quiet.
                for i in range(1, 9):
                    show(last_frame, int(a.brightness * (1 - i / 8.0)))
                    time.sleep(FADE_OUT / 8)
                show(off_frame, a.brightness)
                last_static = "idled"
                wake_until = 0.0
            if idle.wait(0.5):      # returns instantly on the first keypress
                wake_until = time.monotonic() + FADE_IN
        elif eff in STATIC_EFFECTS:
            key = json.dumps(st, sort_keys=True)
            waking = time.monotonic() < wake_until
            if key != last_static or waking:
                last_frame = fn(t, a)
                show(last_frame, _wake_brightness(a.brightness, wake_until))
                # forget the key while fading in, so the last step lands at full
                last_static = None if waking else key
            time.sleep(0.03 if waking else 0.12)
        else:
            last_static = None
            last_frame = fn(t, a)
            show(last_frame, _wake_brightness(a.brightness, wake_until))
            time.sleep(1.0 / max(1.0, a.fps))


def _wake_brightness(brightness, wake_until):
    left = wake_until - time.monotonic()
    if left <= 0:
        return brightness
    return max(1, int(brightness * (1.0 - left / FADE_IN)))


# ---- profiles ----------------------------------------------------------------
def save_profile(name, a):
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    data = {k: getattr(a, k, None) for k in PROFILE_KEYS}
    (PROFILE_DIR / f"{name}.json").write_text(json.dumps(data, indent=2))
    print(f"saved profile '{name}'")


def load_profile(name, a):
    f = PROFILE_DIR / f"{name}.json"
    if not f.exists():
        print(f"no such profile '{name}'")
        sys.exit(1)
    data = json.loads(f.read_text())
    for k in PROFILE_KEYS:
        if k in data:
            setattr(a, k, data[k])
    return a


def showcase(a):
    seq = [("rainbow", 5, None), ("plasma", 5, None), ("meteor", 4, "gold"),
           ("aurora", 5, None), ("candle", 4, "orange"), ("vaporwave", 4, None),
           ("heartbeat", 4, "red"), ("disco", 3, None), ("ocean", 4, None)]
    for name, dur, col in seq:
        print(f"  -> {name} ({dur}s)")
        a.color_set = bool(col)
        if col:
            a.rgb = parse_color(col)
        run_effect(name, a, dur)
    run_effect("gradient", a, 0)


def main():
    p = argparse.ArgumentParser(description="Custom + live + sound RGB effects for the Nitro keyboard.")
    p.add_argument("effect", nargs="?", default="showcase")
    p.add_argument("name", nargs="?", default=None,
                   help="preset name, for the preset/save-preset/del-preset commands")
    p.add_argument("--seconds", type=float, default=0)
    p.add_argument("--brightness", type=int, default=100)
    p.add_argument("--speed", type=float, default=1.0)
    p.add_argument("--amplitude", type=float, default=1.0, help="effect intensity/depth")
    p.add_argument("--fps", type=float, default=18)
    p.add_argument("--color", default=None)
    p.add_argument("--color2", default=None)
    p.add_argument("--zone-colors", dest="zone_colors", default=None,
                   help="per-zone colours, left to right: 'red,gold,green,blue' "
                        "(leave an entry blank to keep the effect's own colour)")
    p.add_argument("--bass-gain", dest="bass_gain", type=float, default=1.0,
                   help="sound effects: how hard the bass reacts")
    p.add_argument("--spec-gain", dest="spec_gain", type=float, default=1.0,
                   help="sound effects: how hard the rest of the spectrum reacts")
    p.add_argument("--bass-zone", dest="bass_zone", type=int, default=ZONES,
                   help="soundbass: which zone (1-4) is the dedicated bass meter")
    p.add_argument("--vu-reverse", dest="vu_reverse", action="store_true",
                   help="soundbass: fill the volume meter from the far end instead")
    p.add_argument("--vu-source", dest="vu_source", default="full",
                   choices=("full", "nobass", "bass"),
                   help="soundbass: what the volume meter rides on")
    p.add_argument("--spec-reverse", dest="spec_reverse", action="store_true",
                   help="sound: put the bass on the right instead of the left")
    p.add_argument("--glow", type=float, default=0.08,
                   help="sound effects: resting glow in silence, 0-0.6 (default 0.08)")
    p.add_argument("--smoothing", dest="snd_smooth", type=float, default=0.57,
                   help="sound effects: 0 = snappy, 1 = smooth (default 0.57)")
    p.add_argument("--gate", dest="snd_gate", type=float, default=0.13,
                   help="sound effects: noise gate, 0-1 (default 0.13)")
    p.add_argument("--adapt", dest="snd_adapt", type=float, default=0.5,
                   help="sound effects: auto-level, 0 = quick, 1 = steady (default 0.5)")
    p.add_argument("--gamma", type=float, default=1.0)
    p.add_argument("--reverse", action="store_true")
    p.add_argument("--save")
    p.add_argument("--load")
    p.add_argument("--effect", dest="set_effect")
    a = p.parse_args()

    if a.load:
        a = load_profile(a.load, a)
    a.color_set = a.color is not None
    a.rgb = parse_color(a.color) if a.color_set else parse_color("purple")
    a.rgb2 = parse_color(a.color2) if a.color2 else parse_color("cyan")
    a.zone_rgb = parse_zones(a.zone_colors)
    a.amp = a.amplitude
    GAMMA[0] = a.gamma

    if a.effect == "daemon":
        try:
            daemon()
        except KeyboardInterrupt:
            pass
        return
    if a.effect == "set":
        kw = {"brightness": a.brightness, "speed": a.speed, "amplitude": a.amplitude,
              "fps": a.fps, "gamma": a.gamma, "reverse": a.reverse, "color": a.color,
              "bass_gain": a.bass_gain, "spec_gain": a.spec_gain,
              "bass_zone": a.bass_zone, "vu_reverse": a.vu_reverse,
              "vu_source": a.vu_source, "spec_reverse": a.spec_reverse,
              "glow": a.glow, "snd_smooth": a.snd_smooth,
              "snd_gate": a.snd_gate, "snd_adapt": a.snd_adapt}
        if a.set_effect:
            kw["effect"] = a.set_effect
        if a.color2:
            kw["color2"] = a.color2
        if a.zone_colors is not None:
            kw["zone_colors"] = a.zone_colors or None
        write_state(**kw)
        return
    if a.effect == "presets":
        for n in list_presets():
            print(" ", n)
        return
    if a.effect in ("preset", "save-preset", "del-preset"):
        if not a.name:
            print(f"usage: nitro-rgb-fx {a.effect} <name>", file=sys.stderr)
            sys.exit(2)
        if a.effect == "save-preset":
            save_preset(a.name)
            print(f"saved preset '{a.name}'")
        elif a.effect == "del-preset":
            preset_path(a.name).unlink(missing_ok=True)
            print(f"deleted preset '{a.name}'")
        else:
            st = load_preset(a.name)
            if st is None:
                print(f"no such preset '{a.name}'", file=sys.stderr)
                sys.exit(1)
            write_state(**st)
            print(f"applied preset '{a.name}'")
        return
    if a.effect == "list":
        for k, (_, desc) in EFFECTS.items():
            print(f"  {k:15s} {desc}")
        return
    if a.effect == "profiles":
        PROFILE_DIR.mkdir(parents=True, exist_ok=True)
        for f in sorted(PROFILE_DIR.glob("*.json")):
            print(" ", f.stem)
        return
    if a.save:
        save_profile(a.save, a)
    try:
        if a.effect == "showcase":
            showcase(a)
        elif a.effect in EFFECTS:
            run_effect(a.effect, a, a.seconds)
        else:
            print(f"unknown effect '{a.effect}'")
            sys.exit(1)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
